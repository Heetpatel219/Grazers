{
  "version": 2,
  "builds": [
    {
      "src": "public/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/signin",  "dest": "/public/signin.html" },
    { "src": "/signup",  "dest": "/public/signup.html" },
    { "src": "/profile", "dest": "/public/profile.html" },
    { "src": "/cart",    "dest": "/public/cart.html" },
    { "src": "/stores",  "dest": "/public/stores.html" },
    { "src": "/(.*)",    "dest": "/public/$1" }
  ]
}
