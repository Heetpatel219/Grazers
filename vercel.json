{
  "version": 2,
  "outputDirectory": "public",
  "routes": [
    { "src": "/signin",  "dest": "/signin.html" },
    { "src": "/signup",  "dest": "/signup.html" },
    { "src": "/profile", "dest": "/profile.html" },
    { "src": "/cart",    "dest": "/cart.html" },
    { "src": "/stores",  "dest": "/stores.html" },
    { "src": "/(.*)",    "dest": "/$1" }
  ]
}
